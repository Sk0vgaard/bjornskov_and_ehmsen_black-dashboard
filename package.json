{
  "name": "bjornskov-ehmsen",
  "version": "1.2.0",
  "description": "Bjørnskov & Ehmsen Website",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "precommit": "npm-run-all -s \"lint:fix\"",
    "lint": "npm-run-all -s \"lint:ts\" \"lint:scss\"",
    "lint:fix": "npm-run-all -s \"lint:ts:fix\" \"lint:scss:fix\" \"prettier:fix\" \"prettier-package:fix\"",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:ts": "ng lint",
    "lint:ts:fix": "npm run lint -- --fix",
    "serve": "ng serve",
    "test:ci": "ng test --run-in-band",
    "test:watch": "ng test --watch",
    "prettier": "prettier --check \"**/*.{js,package.json,css,scss,less,md,ts,html,component.html}\"",
    "prettier-package:fix": "prettier-package-json --write ./package.json",
    "prettier:fix": "prettier --write \"**/*.{js,css,scss,less,md,ts,html,component.html}\"",
    "e2e": "ng e2e",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install",
    "build:gh": "ng build --configuration production --deploy-url=https://sk0vgaard.github.io/bjornskov_and_ehmsen_black-dashboard/ --base-href=",
    "build:prod": "ng build --configuration production",
    "copy404": "ln -s index.html 404.html",
    "firebase:deploy": "ng build --configuration production && firebase deploy --only hosting",
    "homepage": "."
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "18.1.0",
    "@angular/common": "18.1.0",
    "@angular/compiler": "18.1.0",
    "@angular/core": "18.1.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "18.1.0",
    "@angular/localize": "^18.1.0",
    "@angular/platform-browser": "18.1.0",
    "@angular/platform-browser-dynamic": "18.1.0",
    "@angular/router": "18.1.0",
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/angular-fontawesome": "^0.15.0",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@ng-bootstrap/ng-bootstrap": "^17.0.0",
    "chart.js": "4.4.3",
    "cookieconsent": "^3.1.1",
    "core-js": "3.37.1",
    "firebase": "^10.12.3",
    "ngx-cookieconsent": "^6.0.0",
    "ngx-toastr": "^19.0.0",
    "npkill": "^0.12.2",
    "npm-check-updates": "^16.14.20",
    "rxjs": "7.8.1",
    "swiper": "^11.1.4",
    "tslib": "2.6.3",
    "tslint-to-eslint-config": "^2.14.3",
    "zone.js": "0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.1.0",
    "@angular-eslint/builder": "18.1.0",
    "@angular-eslint/eslint-plugin": "18.1.0",
    "@angular-eslint/eslint-plugin-template": "18.1.0",
    "@angular-eslint/schematics": "18.1.0",
    "@angular-eslint/template-parser": "18.1.0",
    "@angular/cli": "18.1.0",
    "@angular/compiler-cli": "18.1.0",
    "@angular/language-service": "18.1.0",
    "@popperjs/core": "2.11.8",
    "@schuchard/prettier": "^5.1.0",
    "@types/jasmine": "5.1.4",
    "@types/jasminewd2": "2.0.13",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-change-detection-strategy": "^0.1.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.7.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jasmine-core": "5.1.2",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "protractor": "7.0.0",
    "stylelint": "^16.7.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "10.9.2",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "5.5.2"
  },
  "lint-staged": {
    "*.{json,css,scss,less,md,html}": [
      "prettier --write"
    ],
    "*.component.html": [
      "prettier --write --parser html"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ],
    "*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
